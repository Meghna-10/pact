# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox). Leave blank = simulated payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Claude for the agents' reasoning/explanations. Leave blank = deterministic rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=5200

# Incident notifications (optional). Without these, emails stay in the outbox and PayPal notices stay drafts.
RESEND_API_KEY=
PACT_FROM_EMAIL=
BUYER_EMAIL=
# Only set this if you have an AUTHORIZED PayPal reporting integration.
PAYPAL_REPORTING_WEBHOOK_URL=

# Optional: merchant account that receives payments (defaults to the app owner)
PAYPAL_PAYEE_EMAIL=

# Free alternative to Claude: Google Gemini (https://aistudio.google.com/apikey). Used only if ANTHROPIC_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
